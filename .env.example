# Settings for compose.yaml. Copy to .env and adjust; scripts/selfhost-setup.sh does that for you.

# Required: the folder that holds both your downloads and your media libraries. Mounted as /data in the container.
# Downloads and media on the same filesystem let Managerr hardlink imports instead of copying them.
#   e.g. /srv/data with /srv/data/downloads and /srv/data/media/{movies,tv,music,books}
DATA_DIR=

# Container image tag. compose.yaml defaults to the multi-arch GHCR image (linux/amd64, linux/arm64).
# Pin a release tag (e.g. :0.2.0) if desired, or build locally with:
#   docker compose -f compose.yaml -f compose.build.yaml up -d --build
# MANAGERR_IMAGE=ghcr.io/m0ritz2k19/managerr:latest

# Where Managerr keeps its databases, the master key and other state. Back this folder up.
CONFIG_DIR=./appdata/config

# The user and group the container runs as. Use the owner of DATA_DIR (`id -u` / `id -g`).
PUID=1000
PGID=1000

# Host interface to bind to (defaults to 127.0.0.1 for local safety; use 0.0.0.0 to expose on your LAN).
MANAGERR_BIND_IP=127.0.0.1

# Port on the host for the web UI and API (http://<host>:8989).
MANAGERR_PORT=8989

# Time zone for schedules and logs, e.g. Europe/Berlin or America/New_York.
TZ=Etc/UTC

# Container name, if you run more than one instance on the host.
CONTAINER_NAME=managerr

# ==============================================================================
# Networking, Reverse Proxy & SSRF Guard (Optional)
# ==============================================================================
# Only trust X-Forwarded-For / X-Forwarded-Proto / X-Forwarded-Host from non-loopback
# reverse proxies when explicitly enabled with non-empty TrustedProxyCidrs (also configurable in Settings -> General):
# Managerr__Auth__TrustForwardedHeaders=false
# Managerr__Auth__TrustedProxyCidrs__0=172.16.0.0/12
# Managerr__Auth__AllowedHosts__0=managerr.example.com
#
# Tailscale / WireGuard CGNAT egress: compose.yaml pre-allows RFC1918 CIDRs (192.168.0.0/16,
# 172.16.0.0/12, 10.0.0.0/8). If services live on Tailscale (100.64.0.0/10), also add:
# SafeHttpEgress__AllowedPrivateCidrs__3=100.64.0.0/10

# ==============================================================================
# Multi-Provider Authentication & Secrets (Optional)
# ==============================================================================
# Any configuration key can be supplied via environment variable (using `__` for
# nesting) or via Docker/Kubernetes secrets by suffixing the env var with `_FILE`
# pointing to the mounted secret path (e.g. Managerr__MasterKey_FILE=/run/secrets/key).

# --- Headless Initial Owner Bootstrap ---
# Automatically create and claim the instance owner on first launch without UI setup:
# Managerr__Auth__Local__BootstrapAdmin__Username=admin
# Managerr__Auth__Local__BootstrapAdmin__Email=admin@example.com
# Managerr__Auth__Local__BootstrapAdmin__DisplayName=Administrator
# Managerr__Auth__Local__BootstrapAdmin__Password=SuperSecretPassword123!
# Or load the password from a file:
# Managerr__Auth__Local__BootstrapAdmin__Password_FILE=/run/secrets/admin_password

# --- OpenID Connect (OIDC 1.0 + PKCE) ---
# Compatible with Authentik, Keycloak, Authelia, Okta, etc.
# Managerr__Auth__Oidc__Enabled=false
# Managerr__Auth__Oidc__DisplayName=SSO
# Managerr__Auth__Oidc__Issuer=https://auth.example.com/application/o/managerr/
# Managerr__Auth__Oidc__ClientId=managerr
# Managerr__Auth__Oidc__ClientSecret=
# Managerr__Auth__Oidc__ClientSecret_FILE=
# Managerr__Auth__Oidc__GroupsClaim=groups
# Managerr__Auth__Oidc__AdminGroups__0=managerr-admins
# Managerr__Auth__Oidc__ManagerGroups__0=managerr-managers
# Managerr__Auth__Oidc__RequesterGroups__0=managerr-users

# --- Passkeys / WebAuthn ---
# Defaults to request origin and "Managerr" RP name if omitted.
# Managerr__Auth__Passkeys__Enabled=true
# Managerr__Auth__Passkeys__RpId=managerr.example.com
# Managerr__Auth__Passkeys__RpName=Managerr
