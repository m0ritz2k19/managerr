# ==============================================================================
# Managerr Full Test Stack (.env)
# Services: Managerr + Seerr + SABnzbd + Plex
# ==============================================================================

# --- Image ---
# Image tag for the Managerr service. The default builds it from this checkout (docker compose up -d --build);
# set a prebuilt image here and start with --no-build to use that instead.
MANAGERR_IMAGE=managerr:local

# --- Host User & Timezone ---
# Match the UID/GID of the host user that owns APPDATA_DIR and DATA_DIR (`id -u` / `id -g`)
PUID=1000
PGID=1000
TZ=Europe/Berlin

# --- Storage Paths ---
# APPDATA_DIR: Per-service configuration & databases (./appdata/{managerr,sabnzbd,seerr,plex})
APPDATA_DIR=./appdata

# DATA_DIR: Shared storage root mounted at /data in Managerr, SABnzbd, and Plex so atomic moves
# (atomic_move) and Unix hardlinks work instantaneously across containers on the same filesystem.
# Expected layout under DATA_DIR:
#   ./data/downloads/incomplete
#   ./data/downloads/complete
#   ./data/media/movies
#   ./data/media/tv
#   ./data/media/anime
#   ./data/media/music
#   ./data/media/books
DATA_DIR=./data

# --- Host Bind IPs & Ports ---
# Defaults to 127.0.0.1 for local testing safety; set to 0.0.0.0 to expose on your LAN
MANAGERR_BIND_IP=127.0.0.1
MANAGERR_PORT=8989

SEERR_BIND_IP=127.0.0.1
SEERR_PORT=5055

SABNZBD_BIND_IP=127.0.0.1
SABNZBD_PORT=8080

PLEX_BIND_IP=127.0.0.1
PLEX_PORT=32400

# --- Managerr Initial Admin Bootstrap ---
# Creates and claims the local initial owner/admin account on first boot so you can sign in
# immediately at http://<host>:8989 without needing Plex OAuth first.
# Alternatively, set MANAGERR_BOOTSTRAP_ENABLED=false and configure
# Managerr__Auth__Local__BootstrapAdmin__Username / __Password directly in compose.yaml.
MANAGERR_BOOTSTRAP_ENABLED=true
MANAGERR_ADMIN_USER=admin
# Required: set a password for the initial bootstrap admin account
MANAGERR_ADMIN_PASS=

# --- Optional: Plex Claim Token ---
# Get a 4-minute claim token from https://www.plex.tv/claim to auto-claim the Plex server on first start
PLEX_CLAIM=
